{
  "version": 2,
  "tempTask": { "root": "%USERPROFILE%\\Downloads", "prefix": "test" },
  "aliases": {
    "blog": {
      "path": "C:\\work\\blog",
      "triggers": ["blog folder", "blog repo", "블로그 폴더"],
      "note": "A bare 'blog' without the word folder or repo usually means the writing notes, not this repository: use the alias 'notes' instead."
    },
    "notes": {
      "path": "%USERPROFILE%\\Documents\\notes",
      "triggers": ["notes", "노트 폴더"]
    },
    "client-x": {
      "path": "D:\\clients\\x\\app",
      "triggers": ["client x app"],
      "confirm": true,
      "note": "Always confirm before opening."
    }
  }
}
