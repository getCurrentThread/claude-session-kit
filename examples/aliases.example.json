{
  "version": 2,
  "tempTask": { "root": "%USERPROFILE%\\Downloads", "prefix": "test" },
  "aliases": {
    "blog": {
      "path": "C:\\work\\blog",
      "triggers": ["blog folder", "blog repo", "블로그 폴더"],
      "note": "A bare mention of 'blog' usually means the live site, not this folder: ask which one before opening."
    },
    "notes": {
      "path": "C:\\work\\notes",
      "triggers": ["notes", "노트 폴더"],
      "note": "Default target when 'blog' is mentioned without the word folder or repo."
    },
    "client-x": {
      "path": "D:\\clients\\x\\app",
      "triggers": ["client x app"],
      "confirm": true,
      "note": "Always confirm before opening."
    }
  }
}
